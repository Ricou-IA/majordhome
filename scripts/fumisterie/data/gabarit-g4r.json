        { "cle": "boisseau", "libelle": "Section intérieure du boisseau (cm)", "choix": [1, 2, 3, 4, 5, 6], "libelles": { "1": "20 × 20", "2": "25 × 25", "3": "30 × 30", "4": "20 × 40", "5": "40 × 40", "6": "30 × 50" }, "defaut": 1 }
