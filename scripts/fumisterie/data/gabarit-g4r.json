        { "cle": "hsp1", "libelle": "Hauteur sous plafond", "unite": "m", "min": 2, "max": 5, "pas": 0.05, "defaut": 2.5 },
        { "cle": "hEntree", "libelle": "Hauteur du piquage dans le conduit", "unite": "m", "min": 0.5, "max": 4, "pas": 0.05, "defaut": 1.5, "optionnel": true, "si": { "entree": "mur" } },
        { "cle": "lHoriz", "libelle": "Longueur horizontale jusqu'au conduit", "unite": "m", "min": 0.1, "max": 3, "pas": 0.05, "defaut": 0.5, "optionnel": true, "si": { "entree": "mur" } }
