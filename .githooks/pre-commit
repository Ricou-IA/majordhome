#!/bin/sh
# ============================================================================
# Pre-commit hook — bloque les commits qui introduisent des erreurs ESLint
# OU qui dépassent le plafond de warnings (--max-warnings de `npm run lint`)
# ============================================================================
# Activé automatiquement via `core.hooksPath=.githooks` (set par le script
# `prepare` de package.json à l'install).
#
# Convention (CLAUDE.md) : 1 nouveau warning → fix immédiat. Le plafond
# --max-warnings de package.json = count actuel ; ce hook est ce qui le rend
# effectif (sans lui, la dérive est invisible — vécu : 417→479 en 7 semaines).
#
# Pour désactiver temporairement (urgence) : `git commit --no-verify`.
# ============================================================================

set -e

echo "[pre-commit] Running ESLint check (errors + warnings ceiling)..."
# Sortie capturée : silencieux si OK (sinon ~400 lignes de warnings à chaque
# commit), affichée (fin du rapport) uniquement en cas de blocage.
# ⚠️ Ne pas remplacer par --quiet : sur ESLint 8 il filtre les warnings AVANT
# le comptage → --max-warnings ne compte plus rien, le plafond devient inerte.
out=$(npm run lint --silent 2>&1) || {
  echo "$out" | tail -60
  echo ""
  echo "❌ ESLint errors détectées ou plafond de warnings dépassé — commit bloqué."
  echo "   Détail complet : npm run lint. Un nouveau warning se corrige, il ne se stocke pas."
  echo "   Bypass d'urgence : --no-verify (déconseillé)."
  exit 1
}

echo "[pre-commit] ✅ ESLint clean (errors + warnings ceiling)."
