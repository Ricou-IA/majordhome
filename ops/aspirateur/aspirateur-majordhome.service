# Unité systemd UTILISATEUR (utilisateur « aspirateur », jamais « hermes » ni « root ») : service de l'aspirateur de
# sites fournisseurs. Installation : README.md. Emplacement : ~/.config/systemd/user/aspirateur-majordhome.service
[Unit]
Description=Aspirateur de sites fournisseurs (Majordhome)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/aspirateur
ExecStart=/usr/bin/node %h/aspirateur/serveur.mjs
# MDH_ASPIRATEUR_KEY, ASPIRATEUR_URL_RETOUR, ASPIRATEUR_URL_MODELE, ASPIRATEUR_PORT, ASPIRATEUR_ECOUTE (fichier en mode 600).
EnvironmentFile=%h/.config/aspirateur/env
Restart=always
RestartSec=5
# Code 1 au démarrage = configuration incomplète : inutile de relancer en boucle, il faut corriger le fichier env.
RestartPreventExitStatus=1
# NoNewPrivileges seulement. PAS de PrivateTmp (ni ProtectSystem / ProtectHome) : dans une unité utilisateur, systemd
# les obtient par un espace de noms, et Chromium ne peut alors plus créer le sien — « No usable sandbox », vécu le
# 2026-11-28 au premier lancement réel. Le bac à sable de Chromium et le filtrage sortant tiennent le confinement.
NoNewPrivileges=yes

[Install]
WantedBy=default.target
